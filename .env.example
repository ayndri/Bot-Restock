# Salin jadi .env lalu isi. File .env tidak ikut ter-commit.

# Dari @BotFather. Untuk development lokal, pakai bot terpisah.
TELEGRAM_BOT_TOKEN=

# String acak bebas (huruf, angka, _ atau -), dipakai Telegram untuk
# membuktikan bahwa request ke webhook memang dari Telegram.
TELEGRAM_WEBHOOK_SECRET=

# String acak bebas (minimal 16 karakter). Vercel Cron mengirimnya ke
# /api/cron supaya pengingat tidak bisa dipicu orang lain.
CRON_SECRET=

# Connection string Neon (yang ada "-pooler" di host-nya).
DATABASE_URL=

# Opsional. ID chat yang boleh memakai bot, pisahkan dengan koma.
# Isi dulu dengan angka asal (misalnya 0), lalu chat bot: balasan
# "bot ini pribadi" menampilkan ID chat kamu.
ALLOWED_CHAT_IDS=
